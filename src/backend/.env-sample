# Ambiente da aplicação
ENVIRONMENT=development
DEBUG=True
API_V2_PREFIX=/api

# Configurações do Banco de Dados (Docker PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartparking

# Para SQLite sem Docker:
# DATABASE_URL=sqlite:///./smartparking.db

# Segurança JWT
SECRET_KEY=sua_chave_secreta_de_producao_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Configurações CORS
# Em produção coloque apenas as origens permitidas
CORS_ORIGINS=["*"]

# Admin e Senha Banco de Dados
EMAIL_ADMIN=
SENHA_ADMIN=

# Chaves para autenticação social (OAuth) - obtenha nos consoles dos provedores:
# Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta for Developers: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Apple Developer: https://developer.apple.com/
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
