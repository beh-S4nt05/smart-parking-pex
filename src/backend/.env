# Ambiente da aplicação
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api

# Configurações do Banco de Dados (Docker PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartparking
# Para SQLite sem Docker:
# DATABASE_URL=sqlite:///./smartparking.db

# Segurança JWT
SECRET_KEY=sua_chave_secreta_de_producao_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Configurações CORS
CORS_ORIGINS=["*"]
