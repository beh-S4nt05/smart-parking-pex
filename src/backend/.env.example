# Copie para src/backend/.env (todas as chaves são OPCIONAIS — os padrões
# funcionam em dev). Lidas via pydantic-settings (core/config.py).

# Banco: é AQUI que se aponta para o Postgres certo.
# Mantenha o driver `+psycopg2` no esquema: SQLAlchemy>=2.1 sem ele procura
# psycopg v3, não acha, e o app cai no fallback como se o banco tivesse morto.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/smartparking
# true: se o Postgres cair, o app silencia o erro e usa SQLite oculto (.smartparking.db).
# Em trabalho em equipe deixe FALSE — dados "fantasma" no SQLite é a pior cilada de dev.
DB_AUTO_SQLITE=true

# Rede do uvicorn (python main.py). PORTA 8000 OCUPADA? mude aqui E no .env do front:
HOST=0.0.0.0
PORT=8000

# JWT
SECRET_KEY=troque-esta-chave-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ambiente: "production" ativa exigência de assinatura HMAC das escritas E o
# guard que RECUSA estas duas chaves com valor de exemplo (a API não sobe).
ENVIRONMENT=development
DEBUG=True

# Segredo do HMAC das requisições assinadas (PROTECAO_REQUISICOES.md). Só é
# cobrado em produção; fora dela qualquer valor funciona.
APP_SIGNING_SECRET=smartparking_default_signing_key_change_in_production

# Login social (Google/Facebook/Apple). Desligado por padrão — as rotas
# respondem 404; ligue só depois de configurar as credenciais do provedor.
LOGIN_SOCIAL_ENABLED=False

# URL pública do APP (usada para montar a URL embutida no QR do simulador)
SIMULADOR_BASE_URL=http://localhost:8081
