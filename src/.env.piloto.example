# COPIE para src/.env.piloto (arquivo local IGNORADO pelo Git).
# Piloto com Postgres e API no proprio Linux, publicado via Tailscale Funnel.
# Gere senhas: openssl rand -hex 32
# Fernet: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Segredo do banco: use apenas letras/numeros hexadecimais, sem caracteres de URL.
PILOT_DB_PASSWORD=
SECRET_KEY=
APP_SIGNING_SECRET=
# Autorizacao no servidor via JWT/RBAC, nao chave distribuida ao cliente.
REQUIRE_CLIENT_HMAC=false
NOTIFICATIONS_ENCRYPTION_KEY=
# Somente apos Firebase/FCM e EAS devidamente configurados.
NOTIFICACOES_PUSH_ENABLED=false
# Opcional se expo exigir autenticacao no projeto; manter PRIVADO.
EXPO_ACCESS_TOKEN=
# Nomes REAIS obtidos depois de criar Funnel e Cloudflare Pages:
TRUSTED_HOSTS=["NOME-REAL.tailnet.ts.net","localhost","127.0.0.1"]
CORS_ORIGINS=["https://NOME-REAL.pages.dev"]
SIMULADOR_BASE_URL=https://NOME-REAL.pages.dev
# Para Gmail, prefira OAuth 2.0/Gmail API (sem senha de app).
# O auxiliar piloto_autorizar_gmail.py grava estes segredos no arquivo PRIVADO.
EMAIL_PROVIDER=smtp
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
# Para SMTP de outro provedor, mantenha EMAIL_PROVIDER=smtp.
# E-mail transacional corporativo (somente backend, nunca no EXPO_PUBLIC_*).
# SMTP do provedor da empresa: STARTTLS 587 OU SSL 465.
# Nao ative sem preencher e testar todos os campos de SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_STARTTLS=true
SMTP_SSL=false
# Preserva contas anteriores. Quando true, novos motoristas precisam confirmar.
SECURITY_VERIFIED_EMAIL_REQUIRED=false
# Consulte src/docs/CONFIRMACAO_EMAIL_EMPRESA.md antes de habilitar.
# O ambiente de desenvolvimento ja usa 8000; expor o piloto isolado em 18000.
# Configure o Funnel para este mesmo numero, nunca publique o banco.
PILOT_API_PORT=18000
