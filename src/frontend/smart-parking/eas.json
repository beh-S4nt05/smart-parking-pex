{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "node": "24.19.0",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview"
    },
    "simulator": {
      "node": "24.19.0",
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "environment": "preview"
    },
    "production": {
      "node": "24.19.0",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "environment": "production"
    }
  }
}