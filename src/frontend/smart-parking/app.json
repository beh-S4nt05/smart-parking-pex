{
  "expo": {
    "name": "Smart Parking",
    "slug": "smart-parking",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./src/assets/imgs/Logo.png",
    "scheme": "smartparking",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "splash": {
      "image": "./src/assets/imgs/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/imgs/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/imgs/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
